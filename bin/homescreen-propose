#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
python="${HOMESCREEN_PYTHON:-$root/.venv/bin/python}"

if [ ! -f "$root/state/scheme.json" ]; then
  cp "$root/templates/scheme.starter.json" "$root/state/scheme.json"
  echo "No state/scheme.json yet; started one from templates/scheme.starter.json." >&2
  echo "Edit its folders to match your own apps, or let Claude draft one from state/current.json." >&2
fi

exec "$python" "$root/lib/propose.py" "$@"
